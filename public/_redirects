# Cada ruta prerenderizada (ver scripts/prerender-meta.mjs) se sirve como
# rewrite 200 desde su propio HTML, para que los scrapers de preview lean los
# tags correctos. El orden importa: gana la primera regla que matchea.
/psicologos    /psicologos.html   200

# La carpeta de archivos de marca se sirve con el listado que genera
# scripts/build-marca-index.mjs. Sin estas reglas /marca caeria en el fallback
# de abajo y mostraria la home en vez del listado.
/marca         /marca/index.html  200
/marca/        /marca/index.html  200

# Convocatoria para psiquiatras. Se comparte por link, asi que necesita su
# HTML propio para que el preview salga bien.
/sumate        /sumate.html       200

# Tarjetas digitales de las directoras. Una regla por persona, igual que las
# demas rutas prerenderizadas: el QR que ellas muestran lleva aca, y el link se
# comparte, asi que el preview tiene que salir bien.
/amanda        /amanda.html       200

# Fallback de la SPA: cualquier otra ruta devuelve el index.html y la resuelve
# React Router en el cliente. Sin esto, entrar directo a una URL o refrescar
# devolveria 404.
/*             /index.html        200
